#!/usr/bin/env bash
set -euo pipefail

SESSION_ENV="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/omatut.env"
SESSION_VALUES="HYPRLAND_INSTANCE_SIGNATURE=${HYPRLAND_INSTANCE_SIGNATURE:-}
WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-}
XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-}"

# The user service does not inherit Hyprland's per-login socket by default.
# Refresh it when the shortcut is invoked; restarting is only needed after a
# new desktop session, never for the second press that submits a question.
if [[ "${HYPRLAND_INSTANCE_SIGNATURE:-}" != "" ]] && ! cmp -s <(printf '%s\n' "$SESSION_VALUES") "$SESSION_ENV" 2>/dev/null; then
  umask 077
  printf '%s\n' "$SESSION_VALUES" > "$SESSION_ENV"
  systemctl --user restart omatut.service
else
  systemctl --user start omatut.service
fi
for _attempt in {1..30}; do
  curl --silent --fail http://127.0.0.1:47841/api/status >/dev/null && break
  sleep 0.1
done

response="$(curl --silent --show-error --fail-with-body -X POST http://127.0.0.1:47841/api/voice/toggle)" || {
  notify-send "OmaTut" "$(jq -r '.error // "Could not start voice guidance."' <<<"${response:-{}}" 2>/dev/null || printf '%s' 'Could not start voice guidance.')"
  exit 1
}

state="$(jq -r '.state // empty' <<<"$response")"
if [[ "$state" == "listening" ]]; then
  notify-send -t 2500 "OmaTut is listening" "Trigger OmaTut again to ask."
fi
