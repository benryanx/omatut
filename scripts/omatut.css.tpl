:root {
  color-scheme: {{ mode }};
  --bg: {{ darker_background }};
  --panel: {{ dark_background }};
  --panel2: {{ background }};
  --line: {{ selection }};
  --text: {{ bright_foreground }};
  --muted: {{ dark_foreground }};
  --accent: {{ accent }};
  --accent2: {{ bright_blue }};
  --accent-contrast: {{ background }};
  --good: {{ green }};
  --danger: {{ red }};
  --warning: {{ yellow }};
}

