#!/usr/bin/env bash
set -euo pipefail
SESSION_ENV="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/omatut.env"
SESSION_VALUES="HYPRLAND_INSTANCE_SIGNATURE=${HYPRLAND_INSTANCE_SIGNATURE:-}
WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-}
XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-}"

if [[ "${HYPRLAND_INSTANCE_SIGNATURE:-}" != "" ]] && ! cmp -s <(printf '%s\n' "$SESSION_VALUES") "$SESSION_ENV" 2>/dev/null; then
  umask 077
  printf '%s\n' "$SESSION_VALUES" > "$SESSION_ENV"
  systemctl --user restart omatut.service
else
  systemctl --user start omatut.service
fi
for _attempt in {1..30}; do
  curl --silent --fail http://127.0.0.1:47841/api/status >/dev/null && break
  sleep 0.1
done
exec chromium --app=http://127.0.0.1:47841 --class=OmaTut --name=OmaTut
